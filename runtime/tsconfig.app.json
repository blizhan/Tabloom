{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["node"],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": false
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "vite.app.config.ts", "build/**/*.ts"]
}
