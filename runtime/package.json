{
  "name": "@tabloom/runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "build": "tsc -p tsconfig.json && vite build",
    "test": "npm run typecheck:test && tsx --test tests/**/*.test.ts",
    "test:unit": "npm run typecheck:test && tsx --test tests/**/*.test.ts",
    "test:browser": "node scripts/run-browser.mjs",
    "fixtures:prepare": "node scripts/prepare-fixtures.mjs",
    "acceptance:summary": "node scripts/summarize-acceptance.mjs",
    "dev": "vite --host 127.0.0.1 --port 4175 --strictPort"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "apache-arrow": "17.0.0",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "playwright-core": "1.63.0",
    "sirv": "3.0.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
